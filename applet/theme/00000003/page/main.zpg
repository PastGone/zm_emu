<screen style="align:center;" title="互动壁纸">
<scrollPane id="sp_only">
<button class="titlebar" onAction="visit(more.zpg,/lock/more)">
<text class="titlebar_txt1">流行前线</text>
<text class="titlebar_txt2">更多</text>
</button>
<container class="theme_container">
<button class="theme_item" onAction="download(3030)">
<container>
<picture class="icon" src="img\3030.png" />
<picture class="status">
<_bitmap>${stat_3030}</_bitmap>
</picture>
</container>
<text>海底世界</text>
</button>
